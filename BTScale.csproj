<Project Sdk="Microsoft.NET.Sdk">
  <!-- Machine-specific settings go in local.props (git-ignored), e.g.:
       <Project><PropertyGroup><BTRoot>D:\Games\BATTLETECH</BTRoot></PropertyGroup></Project>
       Alternatively set the BATTLETECH_DIR environment variable, or pass -p:BTRoot=... on the command line. -->
  <Import Project="local.props" Condition="Exists('local.props')" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>BTScale</AssemblyName>
    <LangVersion>latest</LangVersion>
    <BTRoot Condition="'$(BTRoot)' == '' And '$(BATTLETECH_DIR)' != ''">$(BATTLETECH_DIR)</BTRoot>
    <BTRoot Condition="'$(BTRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\BATTLETECH</BTRoot>
    <BTManaged>$(BTRoot)\BattleTech_Data\Managed</BTManaged>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(BTManaged)\UnityEngine*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BTManaged)\Assembly-CSharp.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BTRoot)\Mods\ModTek\lib\0Harmony.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
